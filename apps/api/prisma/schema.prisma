generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  VIEWER
  OPERATOR
  ADMIN
  @@map("user_role")
}

enum NcProgramStatus {
  // [仮登録] 新規登録(仮登録)の直後、STEP2(変更・登録)で「作業完了（登録）」が
  // 行われるまでの未確定状態。この間は段取シート印刷・作業記録タブを非活性にし、
  // 確定せず離脱した場合は破棄してK_idを解放する(nc.service.ts abandonProvisional参照)。
  PROVISIONAL
  NEW
  PENDING_APPROVAL
  APPROVED
  CHANGING
  @@map("nc_program_status")
}

enum ChangeType {
  NEW_REGISTRATION
  CHANGE
  APPROVAL
  MIGRATION
  @@map("change_type")
}

enum FileType {
  PHOTO
  DRAWING
  PROGRAM
  OTHER
  @@map("file_type")
}

enum SessionType {
  EDIT
  SETUP_PRINT
  WORK_RECORD
  USB_DOWNLOAD
  MC_EDIT
  MC_SETUP_PRINT
  MC_WORK_RECORD
  MC_USB_DOWNLOAD
  @@map("session_type")
}

enum ActionType {
  VIEW
  SEARCH
  EDIT_START
  EDIT_SAVE
  APPROVE
  SETUP_PRINT
  WORK_RECORD
  USB_DOWNLOAD
  FILE_UPLOAD
  FILE_DELETE
  LOGIN
  LOGOUT
  SESSION_START
  SESSION_END
  MC_VIEW
  MC_EDIT_START
  MC_EDIT_SAVE
  MC_APPROVE
  MC_SETUP_PRINT
  MC_WORK_RECORD
  MC_USB_DOWNLOAD
  @@map("action_type")
}

model User {
  id           Int      @id @default(autoincrement())
  employeeCode String   @unique @db.VarChar(20) @map("employee_code")
  name         String   @db.VarChar(50)
  nameKana     String?  @db.VarChar(50)         @map("name_kana")
  passwordHash String   @db.VarChar(255)        @map("password_hash")
  role         UserRole @default(OPERATOR)
  isActive     Boolean  @default(true)          @map("is_active")
  // [v094] 承認資格(旧ACCESS 社員.MC承認資格 相当)。trueのユーザのみ承認操作を実行できる。
  canApprove   Boolean  @default(false)         @map("can_approve")
  avatarPath   String?  @db.VarChar(500)        @map("avatar_path")
  systemType   SystemType @default(NC)          @map("system_type")
  createdAt    DateTime @default(now())         @map("created_at")
  updatedAt    DateTime @updatedAt              @map("updated_at")
  registeredPrograms NcProgram[]     @relation("RegisteredBy")
  approvedPrograms   NcProgram[]     @relation("ApprovedBy")
  changeHistories    ChangeHistory[]
  workRecords        WorkRecord[]
  setupSheetLogs     SetupSheetLog[]
  operationLogs      OperationLog[]
  workSessions       WorkSession[]
  uploadedFiles      NcFile[]
  registeredMcPrograms McProgram[]      @relation("McRegisteredBy")
  approvedMcPrograms   McProgram[]      @relation("McApprovedBy")
  mcChangeHistories    McChangeHistory[]
  mcSetupSheetLogs     McSetupSheetLog[]
  mcUploadedFiles      McFile[]
  mcPgCreatedDetails   McMachiningDetail[]  @relation("McPgCreatedBy")
  mcCreatedDetails      McMachiningDetail[]  @relation("McCreatedBy")
  ncCreatedDetails      NcMachiningDetail[]  @relation("NcCreatedBy")
  timecards            MachineTimecard[]
  @@map("users")
}

model Machine {
  id          Int      @id @default(autoincrement())
  machineCode String   @unique @db.VarChar(20) @map("machine_code")
  machineName String   @db.VarChar(100)        @map("machine_name")
  machineType String?  @db.VarChar(50)         @map("machine_type")
  maker       String?  @db.VarChar(50)
  sortOrder   Int      @default(0)             @map("sort_order")
  isActive    Boolean  @default(true)          @map("is_active")
  createdAt   DateTime @default(now())         @map("created_at")
  updatedAt   DateTime @updatedAt              @map("updated_at")
  systemType  SystemType  @default(NC)  @map("system_type")
  mcSpecs     Json?                     @map("mc_specs")
  // プログラムファイル形式マスタ設定: false=単体ファイル, true=フォルダ単位(メインPG+サブPG)。
  // 新規登録(仮登録)画面で機械選択時にこの値を参照し、ファイル名/フォルダ名を自動決定する。
  pgIsFolder  Boolean  @default(false)  @map("pg_is_folder")
  ncMachiningDetails NcMachiningDetail[]
  workRecords WorkRecord[]
  mcMachiningDetails McMachiningDetail[]
  timecards   MachineTimecard[]
  mcSetupSheetLogs McSetupSheetLog[] @relation("SetupSheetLogMachine")
  @@map("machines")
}

model Part {
  id         Int       @id @default(autoincrement())
  partId     String    @unique @db.VarChar(50) @map("part_id")
  drawingNo  String    @db.VarChar(50)         @map("drawing_no")
  name       String    @db.VarChar(100)
  clientId   Int?                              @map("client_id")
  clientName String?   @db.VarChar(100)        @map("client_name")
  mainModel  String?   @db.VarChar(100)        @map("main_model")
  isActive   Boolean   @default(true)          @map("is_active")
  syncedAt   DateTime?                         @map("synced_at")
  ncPrograms    NcProgram[]
  mcPrograms    McProgram[]
  @@index([drawingNo])
  @@index([name])
  @@map("parts")
}

model CompanySetting {
  id               Int      @id @default(1)
  companyName      String   @db.VarChar(100)  @map("company_name")
  logoPath         String?  @db.VarChar(500)  @map("logo_path")
  uploadBasePath   String?  @db.VarChar(500)  @map("upload_base_path")
  printerName      String?  @db.VarChar(200) @map("printer_name")
  mcStoragePath    String?  @db.VarChar(500)  @map("mc_storage_path")
  ncStoragePath    String?  @db.VarChar(500)  @map("nc_storage_path")
  mcPrinter        String?  @db.VarChar(200)  @map("mc_printer")
  ncPrinter        String?  @db.VarChar(200)  @map("nc_printer")
  updatedAt        DateTime @updatedAt         @map("updated_at")
  @@map("company_settings")
}

model NcMachiningDetail {
  // PK: 旧K_id(ACC_Lathe.K_id)をそのまま使用する。MC側McMachiningDetail.machiningIdが
  // 旧加工IDを直接PKに採用する方式と同じ考え方(autoincrementにしない)。
  kId            Int       @id                              @map("k_id")
  processL       Int       @db.SmallInt                     @map("process_l")
  machineId      Int?                                       @map("machine_id")
  // 加工時間/段取時間: 旧ACC_Lathe.Tm/Tsの意味の違いが未確証のため、
  // MC側cycleTimeSec(1カラム集約)への統合は行わず、2カラム構成を維持する。
  machiningTime  Int?                                       @map("machining_time")
  setupTimeRef   Int?                                       @map("setup_time_ref")
  // フォルダ: 旧ACC_Lathe.FD_nameは単一カラムのため、MC側folder1/folder2分割は適用しない。
  folderName     String    @db.VarChar(100)                 @map("folder_name")
  fileName       String    @db.VarChar(100)                 @map("file_name")
  oNumber        String?   @db.VarChar(20)                  @map("o_number")
  version        String    @default("1.0001") @db.VarChar(10)
  clampNote      String?   @db.Text                         @map("clamp_note")
  drawingCount   Int       @default(0)                      @map("drawing_count")
  photoCount     Int       @default(0)                      @map("photo_count")
  // 将来のNC側「共通部品追加」機能のために列を用意(MC側commonPartCodeと同形)。
  // 今回のデータ移行(nc_full_import.py)では設定しない。
  commonPartCode String?   @db.VarChar(20)                  @map("common_part_code")
  // [v096] MC側McMachiningDetail.creatorId/sheetCreatedAtとの機能パリティのため追加。
  // 段取りシートバック時に手入力される「作成者（段取シート作成者）」「作成日（シート作成日）」。
  creatorId      Int?                                       @map("creator_id")
  sheetCreatedAt DateTime? @db.Date                         @map("sheet_created_at")
  // 画像編集機能(ImageEditor.tsx/files.service.ts saveEditedFile)のファイル名
  // プレフィックスとして使われる加工ID識別文字列。旧NcProgramから移設。
  // nc_full_import.pyでは未設定(常にNULL)、files.service.ts側でmachiningIdへの
  // フォールバックに変更する追従はSTEP3(API修正)で行う。
  processingId   String?   @db.VarChar(50)                  @map("processing_id")
  legacyVer      String?   @db.VarChar(20)                  @map("legacy_ver")
  createdAt      DateTime  @default(now())                  @map("created_at")
  updatedAt      DateTime  @updatedAt                       @map("updated_at")

  machine  Machine?    @relation(fields: [machineId], references: [id])
  creator  User?       @relation("NcCreatedBy", fields: [creatorId], references: [id])
  programs NcProgram[]
  tools    NcTool[]

  @@index([machineId])
  @@map("nc_machining_details")
}

// ============================================================
// NC 正規化テーブル: nc_programs (部品と加工の紐付けのみ保持)
// MC側 mc_programs と同じ考え方。unique制約を持たないことで、
// 同一K_id(NcMachiningDetail)を複数の部品(共通部品)が共有できるようにする。
// ============================================================
model NcProgram {
  id            Int             @id @default(autoincrement())
  partId        Int                                          @map("part_id")
  machiningId   Int                                          @map("machining_id")
  status        NcProgramStatus @default(NEW)
  registeredBy  Int                                          @map("registered_by")
  approvedBy    Int?                                         @map("approved_by")
  registeredAt  DateTime        @default(now())              @map("registered_at")
  approvedAt    DateTime?                                    @map("approved_at")
  // 旧NC_id(ACC_NC.NC_id、部品×加工の対応行ID)。旧legacyKidはNcMachiningDetail側に移動。
  legacyNcId    Int?                                         @map("legacy_nc_id")
  createdAt     DateTime        @default(now())              @map("created_at")
  updatedAt     DateTime        @updatedAt                   @map("updated_at")

  part           Part               @relation(fields: [partId],       references: [id])
  machining      NcMachiningDetail  @relation(fields: [machiningId],  references: [kId])
  registrar      User               @relation("RegisteredBy", fields: [registeredBy], references: [id])
  approver       User?              @relation("ApprovedBy",  fields: [approvedBy],   references: [id])
  files          NcFile[]
  changeHistory  ChangeHistory[]
  workRecords    WorkRecord[]
  setupSheetLogs SetupSheetLog[]
  operationLogs  OperationLog[]
  workSessions   WorkSession[]

  @@index([machiningId])
  @@index([partId])
  @@index([status])
  @@index([legacyNcId])
  @@map("nc_programs")
}

model NcTool {
  id          Int      @id @default(autoincrement())
  // MC側McTooling方式に合わせ、部品(NcProgram)単位ではなく加工データ本体
  // (NcMachiningDetail)単位で持つ。共通部品で複数NcProgramが同じ加工データを
  // 共有しても、ツーリング行は重複登録されない。
  machiningId Int                        @map("machining_id")
  sortOrder   Int      @db.SmallInt      @map("sort_order")
  processType String?  @db.VarChar(50)  @map("process_type")
  chipModel   String?  @db.VarChar(100) @map("chip_model")
  holderModel String?  @db.VarChar(100) @map("holder_model")
  noseR       String?  @db.VarChar(20)  @map("nose_r")
  tNumber     String?  @db.VarChar(10)  @map("t_number")
  note        String?  @db.Text
  createdAt   DateTime @default(now())  @map("created_at")
  updatedAt   DateTime @updatedAt       @map("updated_at")
  machining   NcMachiningDetail @relation(fields: [machiningId], references: [kId], onDelete: Cascade)
  @@index([machiningId, sortOrder])
  @@map("nc_tools")
}

model NcFile {
  id            Int      @id @default(autoincrement())
  ncProgramId   Int                         @map("nc_program_id")
  fileType      FileType @default(OTHER)    @map("file_type")
  originalName  String   @db.VarChar(255)  @map("original_name")
  storedName    String   @db.VarChar(255)  @map("stored_name")
  mimeType      String   @db.VarChar(100)  @map("mime_type")
  filePath      String   @db.VarChar(500)  @map("file_path")
  thumbnailPath String?  @db.VarChar(500)  @map("thumbnail_path")
  fileSize      Int                        @map("file_size")
  // ★NC側PROGRAM(USB自動アップロード)対応: MC側McFileと同項目を追加。
  pgRole        String?  @db.VarChar(10)   @map("pg_role")
  folderName    String?  @db.VarChar(255)  @map("folder_name")
  sortOrder     Int      @default(0)       @map("sort_order")
  isDeleted     Boolean  @default(false)   @map("is_deleted")
  deletedAt     DateTime?                  @map("deleted_at")
  uploadedBy    Int                        @map("uploaded_by")
  uploadedAt    DateTime @default(now())   @map("uploaded_at")
  ncProgram     NcProgram @relation(fields: [ncProgramId], references: [id], onDelete: Cascade)
  uploader      User      @relation(fields: [uploadedBy],  references: [id])
  @@index([ncProgramId, fileType])
  @@map("nc_files")
}

model SpecialSheet {
  id        Int      @id @default(autoincrement())
  clientId  Int?                       @map("client_id")
  keyword   String?  @db.VarChar(100)
  sheetName String   @db.VarChar(100) @map("sheet_name")
  content   String   @db.Text
  pdfPath   String?  @db.VarChar(500) @map("pdf_path")
  version   Int      @default(0)
  createdAt DateTime @default(now())  @map("created_at")
  updatedAt DateTime @updatedAt       @map("updated_at")
  @@index([clientId])
  @@map("special_sheets")
}

model ChangeHistory {
  id            Int        @id @default(autoincrement())
  ncProgramId   Int                        @map("nc_program_id")
  changeType    ChangeType                 @map("change_type")
  operatorId    Int                        @map("operator_id")
  versionBefore String?    @db.VarChar(10) @map("version_before")
  versionAfter  String?    @db.VarChar(10) @map("version_after")
  content       String?    @db.Text
  fieldChanges  Json?                      @map("field_changes")
  changedAt     DateTime   @default(now()) @map("changed_at")
  legacyHistId  Int?                       @map("legacy_hist_id")
  ncProgram     NcProgram  @relation(fields: [ncProgramId], references: [id])
  operator      User       @relation(fields: [operatorId],  references: [id])
  @@index([ncProgramId, changedAt])
  @@index([legacyHistId])
  @@map("change_history")
}

model WorkRecord {
  id               Int      @id @default(autoincrement())
  ncProgramId      Int?                      @map("nc_program_id")
  mcProgramId      Int?                      @map("mc_program_id")
  operatorId       Int                       @map("operator_id")
  machineId        Int?                      @map("machine_id")
  workDate         DateTime @db.Date         @map("work_date")
  setupTimeMin     Int?                      @map("setup_time_min")
  machiningTimeMin Int?                      @map("machining_time_min")
  quantity         Int?
  note             String?  @db.Text
  workType         String?  @db.VarChar(20)  @map("work_type")
  cycleTimeSec     Int?                      @map("cycle_time_sec")
  interruptionTimeMin Int?                   @map("interruption_time_min")
  startedAt        DateTime?                 @map("started_at")
  checkedAt        DateTime?                 @map("checked_at")
  finishedAt       DateTime?                 @map("finished_at")
  interruptSetupMin Int?                     @map("interrupt_setup_min")
  interruptWorkMin  Int?                     @map("interrupt_work_min")
  setupWorkCount    Int?                     @map("setup_work_count")
  sessionId        String?  @db.VarChar(36)  @map("session_id")
  setupOperatorIds        Json?              @default("[]") @map("setup_operator_ids")
  productionOperatorIds   Json?              @default("[]") @map("production_operator_ids")
  prgMan                  String?  @db.VarChar(100)  @map("prg_man")
  prgTimeMin              Int?                       @map("prg_time_min")
  prgPlas                 String?  @db.VarChar(50)   @map("prg_plas")
  createdAt        DateTime @default(now())  @map("created_at")
  ncProgram        NcProgram? @relation(fields: [ncProgramId], references: [id])
  mcProgram        McProgram? @relation(fields: [mcProgramId], references: [id])
  operator         User       @relation(fields: [operatorId],  references: [id])
  machine          Machine?   @relation(fields: [machineId],   references: [id])
  @@index([ncProgramId, workDate])
  @@index([mcProgramId, workDate])
  @@index([operatorId, workDate])
  @@map("work_records")
}

model SetupSheetLog {
  id          Int      @id @default(autoincrement())
  ncProgramId Int                        @map("nc_program_id")
  operatorId  Int                        @map("operator_id")
  printedAt   DateTime @default(now())   @map("printed_at")
  version     String?  @db.VarChar(10)
  pdfPath        String?  @db.VarChar(500)  @map("pdf_path")
  sessionId      String?  @db.VarChar(36)   @map("session_id")
  workCollected  Boolean  @default(false)   @map("work_collected")
  isLost         Boolean  @default(false)   @map("is_lost")
  lostReason     String?  @db.VarChar(50)   @map("lost_reason")
  lostDetail     String?  @db.Text          @map("lost_detail")
  lostAt         DateTime?                  @map("lost_at")
  lostBy         Int?                       @map("lost_by")
  ncProgram   NcProgram @relation(fields: [ncProgramId], references: [id])
  operator    User      @relation(fields: [operatorId],  references: [id])
  @@index([ncProgramId, printedAt])
  @@map("setup_sheet_logs")
}

model OperationLog {
  id          Int        @id @default(autoincrement())
  userId      Int?                        @map("user_id")
  ncProgramId Int?                        @map("nc_program_id")
  actionType  ActionType                  @map("action_type")
  sessionId   String?    @db.VarChar(36)  @map("session_id")
  ipAddress   String?    @db.VarChar(45)  @map("ip_address")
  userAgent   String?    @db.VarChar(500) @map("user_agent")
  metadata    Json?
  createdAt   DateTime   @default(now())  @map("created_at")
  mcProgramId Int?                        @map("mc_program_id")
  user        User?      @relation(fields: [userId],       references: [id])
  ncProgram   NcProgram? @relation(fields: [ncProgramId],  references: [id])
  mcProgram   McProgram? @relation(fields: [mcProgramId],  references: [id])
  @@index([ncProgramId, createdAt])
  @@index([mcProgramId, createdAt])
  @@index([userId, createdAt])
  @@index([actionType, createdAt])
  @@map("operation_logs")
}

model WorkSession {
  id          String      @id @default(uuid())
  userId      Int                         @map("user_id")
  ncProgramId Int?                        @map("nc_program_id")
  mcProgramId Int?                        @map("mc_program_id")
  sessionType SessionType                 @map("session_type")
  startedAt   DateTime    @default(now()) @map("started_at")
  endedAt     DateTime?                   @map("ended_at")
  isActive    Boolean     @default(true)  @map("is_active")
  expiresAt   DateTime                    @map("expires_at")
  user        User        @relation(fields: [userId],       references: [id])
  ncProgram   NcProgram?  @relation(fields: [ncProgramId],  references: [id])
  mcProgram   McProgram?  @relation(fields: [mcProgramId],  references: [id])
  @@index([ncProgramId, isActive])
  @@index([mcProgramId, isActive])
  @@index([userId, isActive])
  @@map("work_sessions")
}

// ============================================================
// MC システム追加 Enum
// ============================================================

enum SystemType {
  NC
  MC
  BOTH
  @@map("system_type")
}

enum McProgramStatus {
  NEW
  PENDING_APPROVAL
  APPROVED
  CHANGING
  @@map("mc_program_status")
}

// ============================================================
// MC システム新規モデル
// ============================================================

// ============================================================
// MC 正規化テーブル: mc_machining_details (旧マシニングテーブル相当)
// machining_id が PK、加工プログラム本体情報を保持
// ============================================================
model McMachiningDetail {
  machiningId     Int       @id                              @map("machining_id")
  version         String    @default("1.0001") @db.VarChar(10)
  machineId       Int?                                       @map("machine_id")
  oNumber         String?   @db.VarChar(50)                  @map("o_number")
  clampNote       String?   @db.Text                         @map("clamp_note")
  cycleTimeSec    Int?                                        @map("cycle_time_sec")
  mcProcessNo     Int?      @db.SmallInt                     @map("mc_process_no")
  folder1         String?   @db.VarChar(50)
  folder2         String?   @db.VarChar(50)
  fileName        String?   @db.VarChar(50)                  @map("file_name")
  hasIndexProgram Boolean   @default(false)                  @map("has_index_program")
  hasWorkOffset   Boolean   @default(false)                  @map("has_work_offset")
  rc              Int       @default(0)
  pgIsFolder      Boolean   @default(false)                  @map("pg_is_folder")
  pgFolderName    String?   @db.VarChar(100)                 @map("pg_folder_name")
  pgCreatedBy     Int?                                        @map("pg_created_by")
  pgUpdatedAt     DateTime?                                   @map("pg_updated_at")
  creatorId       Int?                                        @map("creator_id")
  sheetCreatedAt  DateTime? @db.Date                         @map("sheet_created_at")
  commonPartCode  String?   @db.VarChar(20)                  @map("common_part_code")
  legacyKakoid    Int?                                        @map("legacy_kakoid")
  createdAt       DateTime  @default(now())                  @map("created_at")
  updatedAt       DateTime  @updatedAt                       @map("updated_at")

  machine       Machine?         @relation(fields: [machineId],  references: [id])
  pgCreator     User?            @relation("McPgCreatedBy",  fields: [pgCreatedBy],  references: [id])
  creator       User?            @relation("McCreatedBy",    fields: [creatorId],    references: [id])
  programs      McProgram[]
  tooling       McTooling[]
  workOffsets   McWorkOffset[]
  indexPrograms McIndexProgram[]

  @@index([machineId])
  @@index([legacyKakoid])
  @@map("mc_machining_details")
}

// ============================================================
// MC 正規化テーブル: mc_programs (旧MCテーブル相当)
// id が PK (旧MCID相当)、部品と加工の紐付けのみ保持
// ============================================================
model McProgram {
  id            Int             @id @default(autoincrement())
  partId        Int                                          @map("part_id")
  machiningId   Int                                          @map("machining_id")
  machiningQty  Decimal?        @db.Decimal(10, 4) @default(1) @map("machining_qty")
  note          String?         @db.Text
  status        McProgramStatus @default(NEW)
  registeredBy  Int                                          @map("registered_by")
  approvedBy    Int?                                         @map("approved_by")
  registeredAt  DateTime        @default(now())              @map("registered_at")
  approvedAt    DateTime?                                    @map("approved_at")
  legacyMcid    Int?                                         @map("legacy_mcid")
  createdAt     DateTime        @default(now())              @map("created_at")
  updatedAt     DateTime        @updatedAt                   @map("updated_at")

  part          Part               @relation(fields: [partId],       references: [id])
  machining     McMachiningDetail  @relation(fields: [machiningId],   references: [machiningId])
  registrar     User               @relation("McRegisteredBy", fields: [registeredBy], references: [id])
  approver      User?              @relation("McApprovedBy",   fields: [approvedBy],   references: [id])
  files         McFile[]
  changeHistory McChangeHistory[]
  workRecords   WorkRecord[]
  setupSheetLogs McSetupSheetLog[]
  workSessions  WorkSession[]
  operationLogs OperationLog[]

  @@index([machiningId])
  @@index([partId])
  @@index([status])
  @@index([legacyMcid])
  @@map("mc_programs")
}

model McTooling {
  id              Int      @id @default(autoincrement())
  machiningId     Int                          @map("machining_id")
  // ★smallint(上限32767)だと、ACC_ツーリング.順番列を10倍化した際に
  //   異常に大きい順番値を持つ行でオーバーフローし、INSERT自体が失敗する
  //   (実際に786件のINSERT失敗を確認)。integer(上限約21億)に変更し、
  //   10倍化後の値がどのような大きさでも安全に格納できるようにする。
  sortOrder       Int                          @map("sort_order")
  toolNo          String?  @db.VarChar(20)     @map("tool_no")
  toolName        String?  @db.VarChar(100)    @map("tool_name")
  tNo             String?  @db.VarChar(10)     @map("t_no")
  dValueContent   String?  @db.VarChar(50)     @map("d_value_content")
  subPgNo         String?  @db.VarChar(20)     @map("sub_pg_no")
  diameter        Decimal? @db.Decimal(8, 3)
  lengthOffsetNo  String?  @db.VarChar(10)     @map("length_offset_no")
  diaOffsetNo     String?  @db.VarChar(10)     @map("dia_offset_no")
  toolType        String?  @db.VarChar(50)     @map("tool_type")
  note            String?  @db.Text
  rawProgramLine  String?  @db.Text            @map("raw_program_line")
  createdAt       DateTime @default(now())     @map("created_at")
  updatedAt       DateTime @updatedAt          @map("updated_at")

  machining McMachiningDetail @relation(fields: [machiningId], references: [machiningId], onDelete: Cascade)

  @@index([machiningId, sortOrder])
  @@map("mc_tooling")
}

model McWorkOffset {
  id          Int      @id @default(autoincrement())
  machiningId Int                          @map("machining_id")
  gCode       String   @db.VarChar(10)     @map("g_code")
  // ★旧ACC_ワークオフセットのX/Y/Z/A/R列は小数点以下4桁の精度を持つ
  //   (例: -538.4672)。Decimal(12,3)では第4桁が丸められ、データが
  //   1桁少ない精度で保存されていた(実際に244件の不一致を確認)。
  //   Decimal(12,4)に変更し、旧データの精度をそのまま保持できるようにする。
  xOffset     Decimal? @db.Decimal(12, 4)  @map("x_offset")
  yOffset     Decimal? @db.Decimal(12, 4)  @map("y_offset")
  zOffset     Decimal? @db.Decimal(12, 4)  @map("z_offset")
  aOffset     Decimal? @db.Decimal(12, 4)  @map("a_offset")
  rOffset     Decimal? @db.Decimal(12, 4)  @map("r_offset")
  note        String?  @db.VarChar(100)
  createdAt   DateTime @default(now())     @map("created_at")
  updatedAt   DateTime @updatedAt          @map("updated_at")

  machining McMachiningDetail @relation(fields: [machiningId], references: [machiningId], onDelete: Cascade)

  @@map("mc_work_offsets")
}

model McIndexProgram {
  id          Int      @id @default(autoincrement())
  machiningId Int                          @map("machining_id")
  sortOrder   Int      @db.SmallInt        @map("sort_order")
  axis0       String?  @db.VarChar(100)    @map("axis_0")
  axis1       String?  @db.VarChar(100)    @map("axis_1")
  axis2       String?  @db.VarChar(100)    @map("axis_2")
  note        String?  @db.Text
  createdAt   DateTime @default(now())     @map("created_at")
  updatedAt   DateTime @updatedAt          @map("updated_at")

  machining McMachiningDetail @relation(fields: [machiningId], references: [machiningId], onDelete: Cascade)

  @@index([machiningId, sortOrder])
  @@map("mc_index_programs")
}

model MachineTimecard {
  id         Int      @id @default(autoincrement())
  machineId  Int                          @map("machine_id")
  operatorId Int                          @map("operator_id")
  workDate   DateTime @db.Date            @map("work_date")
  startTime  DateTime @db.Time(0)         @map("start_time")
  endTime    DateTime @db.Time(0)         @map("end_time")
  note       String?  @db.VarChar(200)
  createdAt  DateTime @default(now())     @map("created_at")

  machine  Machine @relation(fields: [machineId],  references: [id])
  operator User    @relation(fields: [operatorId], references: [id])

  @@unique([machineId, workDate])
  @@index([workDate])
  @@map("machine_timecards")
}

model McFile {
  id            Int      @id @default(autoincrement())
