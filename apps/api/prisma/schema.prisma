  mcProgram McProgram @relation(fields: [mcProgramId], references: [id], onDelete: Cascade)
  uploader  User      @relation(fields: [uploadedBy],  references: [id])

  @@index([mcProgramId, fileType])
  @@map("mc_files")
}

model McChangeHistory {
